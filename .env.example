# ──────────────────────────────────────────────
# Tienda — Environment Variables Reference
# ──────────────────────────────────────────────
# All variables validated via @tienda/config.
# Copy this file to .env and customize.
# ──────────────────────────────────────────────

# ─── App ─────────────────────────────────────
PORT=4000
API_PREFIX=api/v1
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda"
DATABASE_URL_DIRECT="postgresql://postgres:postgres@localhost:5432/tienda"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda_shadow"
DATABASE_URL_REPLICA="postgresql://postgres:postgres@localhost:5432/tienda_replica"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_QUERY_TIMEOUT=30000
DATABASE_CONNECTION_RETRIES=5
DATABASE_RETRY_DELAY=2000

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Storage ────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tienda-assets

# ─── Mail ────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=

# ─── Cache ──────────────────────────────────
CACHE_TTL=86400
CACHE_PREFIX=tienda:

# ─── Queue ──────────────────────────────────
QUEUE_REDIS_URL=

# ─── Security ───────────────────────────────
ENCRYPTION_KEY=
BCRYPT_ROUNDS=12

# ─── Rate Limit ─────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── Logging ────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ─── Frontend (public) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_VERSION=0.0.0
