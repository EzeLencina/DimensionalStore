# ──────────────────────────────────────────────
# Docker Environment — Tienda
# Copy to .env.docker and customize
# ──────────────────────────────────────────────

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tienda

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tienda
DATABASE_URL_DIRECT=postgresql://postgres:postgres@postgres:5432/tienda
SHADOW_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tienda_shadow

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_QUERY_TIMEOUT=30000
DATABASE_CONNECTION_RETRIES=5
DATABASE_RETRY_DELAY=2000

# Backend
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://redis:6379

# Storage (MinIO / R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=tienda-assets

# Mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_VERSION=0.0.0
